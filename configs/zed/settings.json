{
  "diff_view_style": "unified",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine",
  },
  "base_keymap": "None",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_size": 13,
  "ui_font_size": 13,
  "active_pane_modifiers": {
    "inactive_opacity": 0.8,
  },
  "bottom_dock_layout": "left_aligned",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "vim_mode": true,
  "restore_on_startup": "empty_tab",
  "cli_default_open_behavior": "new_window",
  "close_on_file_delete": true,
  "zoomed_padding": false,
  "lsp_highlight_debounce": 0,
  "completion_menu_item_kind": "symbol",
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "code_lens": "menu",
  "wrap_guides": [80, 128],
  "allow_rewrap": "in_selections",
  "toolbar": {
    "quick_actions": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "scrollbar": {
    "show": "never",
  },
  "minimap": {
    "show": "always",
    "thumb": "hover",
  },
  "middle_click_paste": false,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "vertical_scroll_margin": 8,
  "autoscroll_on_clicks": true,
  "horizontal_scroll_margin": 8,
  "sticky_scroll": {
    "enabled": true,
  },
  "relative_line_numbers": "enabled",
  "search_wrap": false,
  "search": {
    "button": false,
  },
  "use_smartcase_search": true,
  "inlay_hints": {
    "enabled": true,
    "show_value_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_type_hints": true,
    "show_background": true,
    "edit_debounce_ms": 100,
    "scroll_debounce_ms": 0,
  },
  "project_panel": {
    "bold_folder_labels": false,
    "dock": "left",
    "button": false,
    "scrollbar": {
      "horizontal_scroll": false,
    },
    "diagnostic_badges": true,
    "git_status_indicator": true,
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "button": false,
    "status_style": "label_color",
    "file_icons": true,
    "tree_view": true,
  },
  "agent": {
    "button": false,
    "enabled": false,
  },
  "semantic_tokens": "combined",
  "document_folding_ranges": "on",
  "document_symbols": "on",
  "tab_bar": {
    "show": false,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "ensure_final_newline_on_save": false,
  "format_on_save": "on",
  "preferred_line_length": 128,
  "diagnostics": {
    "button": false,
    "lsp_pull_diagnostics": {
      "debounce_ms": 0,
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 0,
    },
  },
  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/.git/",
    "**/.venv/",
    "**/.cache/",
    "**/.zig-cache/",
    "**/__pycache__/",
    "build/",
    "Build/",
    "dist-newstyle/",
    "bin/",
    "node_modules/",
  ],
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false,
  },
  "terminal": {
    "keep_selection_on_copy": false,
    "button": false,
  },
  "file_types": {
    "C": ["*.c", "*.h"],
    "YAML": [".clangd", ".clang-format"],
    "CMake": ["cmakelists.txt"],
  },
  "auto_install_extensions": {
    "html": false,
    "rose-pine-theme": true,
  },
  "languages": {
    "C": {
      "inlay_hints": {
        "show_parameter_hints": false,
      },
    },
    "Go": {
      "inlay_hints": {
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "JavaScript": {
      "inlay_hints": {
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "LaTeX": {
      "document_symbols": "off",
      "prettier": {
        "allowed": false,
      },
    },
    "Markdown": {
      "tab_size": 2,
      "allow_rewrap": "anywhere",
      "remove_trailing_whitespace_on_save": true,
      "ensure_final_newline_on_save": false,
      "soft_wrap": "editor_width",
      "document_symbols": "off",
      "completions": {
        "words": "fallback",
      },
      "prettier": {
        "allowed": false
      },
    },
    "TypeScript": {
      "inlay_hints": {
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "Zig": {
      "inlay_hints": {
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "TOML": {
      "document_symbols": "off",
    },
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": ["%f"],
            "onSave": true,
            "useFileList": true,
            "auxDirectory": "out",
            "logDirectory": "out",
            "pdfDirectory": "out",
          },
        },
      },
    },
    "lua-language-server": {
      "binary": {
        "arguments": ["--configpath", "$XDG_CONFIG_HOME/zed/.luarc.json"],
      },
    },
    "hls": {
      "initialization_options": {
        "haskell": {
          "formattingProvider": "fourmolu",
          "maxCompletions": 128,
          "plugin": {
            "cabal": {
              "globalOn": true,
              "codeActionsOn": true,
              "completionOn": true,
              "diagnosticsOn": true,
              "hoverOn": true,
              "symbolsOn": true,
            },
            "cabalHaskellIntegration": { "globalOn": true },
            "callHierarchy": { "globalOn": true },
            "changeTypeSignature": { "globalOn": true },
            "class": {
              "globalOn": true,
              "codeActionsOn": true,
              "codeLensOn": true,
            },
            "eval": {
              "globalOn": true,
              "codeActionsOn": true,
              "codeLensOn": true,
              "config": {
                "diff": true,
                "exception": false,
              },
            },
            "explicit-fields": {
              "globalOn": true,
              "codeActionsOn": true,
              "inlayHintsOn": true,
            },
            "explicit-fixity": { "globalOn": true },
            "gadt": { "globalOn": true },
            "ghcide-code-actions-bindings": { "globalOn": true },
            "ghcide-code-actions-fill-holes": { "globalOn": true },
            "ghcide-code-actions-imports-exports": { "globalOn": true },
            "ghcide-code-actions-type-signatures": { "globalOn": true },
            "ghcide-completions": {
              "config": {
                "autoExtendOn": true,
                "snippetsOn": true,
              },
              "globalOn": true,
            },
            "ghcide-hover-and-symbols": {
              "globalOn": true,
              "hoverOn": true,
              "symbolsOn": true,
            },
            "ghcide-type-lenses": {
              "config": { "mode": "always" },
              "globalOn": true,
            },
            "hlint": {
              "globalOn": true,
              "codeActionsOn": true,
              "config": {
                "flags": [],
              },
              "diagnosticsOn": true,
            },
            "importLens": {
              "globalOn": true,
              "codeActionsOn": true,
              "codeLensOn": true,
              "inlayHintsOn": true,
            },
            "moduleName": { "globalOn": true },
            "overloaded-record-dot": { "globalOn": true },
            "pragmas-completion": { "globalOn": true },
            "pragmas-disable": { "globalOn": true },
            "pragmas-suggest": { "globalOn": true },
            "qualifyImportedNames": { "globalOn": true },
            "rename": {
              "config": { "crossModule": true },
              "globalOn": true,
            },
          },
        },
      },
    },
  },
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "which_key": {
    "enabled": true,
  },
  "debugger": {
    "button": false,
  },
}
